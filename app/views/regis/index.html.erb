<style>
  .table { table-layout: auto !important; width: 100%; border-collapse: collapse; }
  .table th, .table td { padding: 4px 4px !important; vertical-align: middle; }

  /* 1. NAME FIX: Force names to shrink so they don't push the dates */
  .col-name { 
    width: 1% !important; 
    max-width: 130px !important; 
    overflow: hidden; 
    text-overflow: ellipsis; 
    white-space: nowrap; 
  }

  /* 2. DATE LOCK: Rigid width to prevent wrapping */
  .col-date { 
    width: 115px !important; 
    min-width: 115px !important; 
    white-space: nowrap !important;
    text-align: center; 
  }

  /* 3. ACTION COMPRESSION: Compact 4-button group */
  .col-actions { 
    width: 1% !important; 
    white-space: nowrap !important;
    text-align: center;
    padding: 4px 6px !important;
  }

  /* 4. UTILITY COLUMNS: Fixed widths */
  .col-mi     { width: 35px !important; text-align: center; }
  .col-gender { width: 70px !important; text-align: center; }
  .col-age    { width: 45px !important; text-align: center; }

  /* 5. UNIFIED BUTTONS & BADGES */
  .btn-mini, .status-badge {
    font-size: 0.65rem !important;
    height: 24px !important;
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    vertical-align: middle;
    margin: 0 1px;
  }

  .btn-mini { padding: 1px 6px !important; }
  
  .status-badge {
    width: 70px !important;
    border-width: 2px !important;
    font-weight: 800 !important;
    text-transform: uppercase;
  }

  @media print {
    .btn, .nav, .search-bar, .d-flex, footer, .card-header, .pagination { display: none !important; }
    body { background: white !important; margin: 0; }
    .table { width: 100% !important; font-size: 10pt; }
  }
</style>

<h2 class="text-center pb-3">Patient Registration as of <%= Time.now.strftime("%Y-%m-%d %I:%M %p") %></h2>

<div class="d-flex align-items-center justify-content-center mx-2 gap-1">
  <%# Row 1: Action Buttons and Sign Out %>
  <%= link_to "New Patient", new_regi_path, class: "btn btn-dark border border-light border-3 rounded-pill mx-1 px-3 py-0 fw-bold" %>
  <%= link_to 'All Charts by Date', overviews_chart_date_path, class: "btn btn-primary border border-light border-3 rounded-pill mx-1 px-2 py-0 fw-bold" %>
  <%= link_to 'All Charts by Name', overviews_chart_name_path, class: "btn btn-success border border-light border-3 rounded-pill mx-1 px-2 py-0 fw-bold" %>
  <%= link_to 'All Patient Info', overviews_patient_info_path, class: "btn btn-info border border-light border-3 rounded-pill mx-1 px-2 py-0 fw-bold" %>
  <%= link_to 'Print All', 
  url_for(params.to_unsafe_h.merge(print: true)), 
  class: "btn btn-sm btn-secondary border border-light border-3 rounded-pill px-3 py-0 fw-bold" %>
</div>
  
<%# Row 2: Search Bar %>
<%# Row 2: Search Bar - Updated for perfect alignment %>
<div class="container-fluid px-4">
  <div class="d-flex justify-content-center w-100 mb-3">
    <div style="max-width: 900px; width: 100%;">
      <%= render "shared/search_bar", q: @q, url: regis_path %>
    </div>
  </div>
</div>

<%# Row 3: Letter Links %>
<div class="d-flex flex-wrap justify-content-center gap-1 mb-3">
  <% ('A'..'Z').each do |letter| %>
    <%= link_to letter, 
    url_for(letter: letter), 
    class: "btn btn-sm btn-warning text-white border border-light border-3 fw-bolder #{params[:letter] == letter ? 'btn-warning' : 'btn-outline-secondary'} rounded-circle shadow-sm",
      style: "width: 35px;" %>
  <% end %>
  <%= link_to "All", url_for(letter: "All"), class: "btn btn-sm btn-warning text-white border border-light border-3 fw-bolder rounded-pill px-3 shadow-sm" %>
</div>

<div class="card mt-0 mx-auto border-primary shadow" style="width: 68rem;">     
  <div class="card-body pt-2">

    <table class="table table-sm table-striped table-hover custom-table mx-auto">
    <thead class="table-primary">
  <tr>
    <th class="col-name">Last Name</th>
    <th class="col-name">First Name</th>
    <th class="col-mi">M.I.</th>
    <th class="col-gender">Gender</th>
    <th class="col-age">Age</th>
    <th class="col-date">Date of Birth</th>
    <th class="col-date">Created on</th>
    <th class="col-actions">Actions</th>
  </tr>
</thead>
      <tbody class="fs-4">
        <% @regis.each do |regi| %>
        <tr>
          <td><%= link_to regi.last_name, regi_path(regi.id) %></td>
          <td><%= regi.first_name %></td>
          <td class="text-center"><%= regi.init? ? regi.init + "." : "" %></td>
          <td><%= regi.gender %></td>
          <td class="text-center"><%= regi.p_age %></td>
          <td class="text-center"><%= regi.dob %></td>
          <td class="text-center"><%= regi.created_at.strftime("%Y-%m-%d") %></td>
                       
          <td class="col-actions align-middle pe-4">
          <div class="d-flex align-items-center justify-content-center gap-1">
            <%= link_to 'Chart', regi_charts_path(regi.id), 
                class: "btn btn-mini btn-outline-primary outline-double border border-lg border-primary rounded-pill fw-bold" %>
            <%= link_to 'Info', regi_patients_path(regi.id), 
                class: "btn btn-mini btn-outline-dark outline-double border border-lg border-dark rounded-pill fw-bold" %>
            <%= link_to 'Files', regi_filings_path(regi.id), 
                class: "btn btn-mini btn-outline-success outline-double border border-lg border-success rounded-pill fw-bold" %>
            <% status = regi.onboarding_status %>
            <% if status == "DigiSigned" %>
              <span class="badge bg-primary fw-bold" style="font-size: 0.85rem; padding: 2px 8px;">
                Signed
              </span>
            <% elsif status == "Issued" %>
              <%= link_to "Issued", revoke_access_regi_path(regi), data: { turbo_method: :post }, 
                  class: "badge bg-success text-decoration-none fw-bold", 
                  style: "font-size: 0.85rem; padding: 2px 8px;" %>
            <% else %>
              <%= link_to "SignUp", issue_access_regi_path(regi), data: { turbo_method: :post }, 
                  class: "badge bg-warning text-dark text-decoration-none fw-bold", 
                  style: "font-size: 0.85rem; padding: 2px 8px;" %>
            <% end %>

          </div>
        </td>
        </tr>
        <% end %>
      </tbody>
    </table>
    </div>
      <div class="d-flex justify-content-center my-2">
        <%== pagy_bootstrap_nav(@pagy) if @pagy&.pages.to_i > 1 %>
      </div>
    </div>
  </div>
</div>

<% if params[:print] == "true" %>
  <script>
    (function() {
      const checkTable = setInterval(() => {
        const rows = document.querySelectorAll('table tbody tr');
        if (rows.length > 0) {
          clearInterval(checkTable);
          setTimeout(() => {
            window.print();
            // Automatically clean the URL after printing
            window.location.href = window.location.href.replace(/[&?]print=true/, '');
          }, 1000);
        }
      }, 100);
    })();
  </script>

  
<% end %>

