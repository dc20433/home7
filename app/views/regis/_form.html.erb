<h1 class="card-title text-center pb-2">Patient Registration</h1>

<div class="card mt-0 mx-auto p-4 border-primary shadow" style="width: 35rem;">

  <%= form_with(model: @regi) do |form| %>
    <% if @regi.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(@regi.errors.count, "error") %> prohibited this regi from being saved:</h2>

        <ul>
          <% @regi.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="row mt-3 d-flex">
      <div class="col col-md-3 text-nowrap align-self-center", style="vertical-align: middle;">
        <b><%= form.label :last_name, "Last Name" %></b>
      </div>
      <div class="col col-md-9">
        <%= form.text_field :last_name, autofocus: true, class:"form-control form-control-sm border-primary fs-4" %>
      </div>
    </div>

    <div class="row mt-3">
      <div class="col col-md-3 pt-1 text-nowrap align-self-center">
        <b><%= form.label :first_name, "First Name" %></b>
      </div>
      <div class="col col-md-9">
        <%= form.text_field :first_name, class:"form-control form-control-sm border-primary fs-4" %>
      </div>
    </div>

    <div class="row mt-3">
      <div class="col col-md-3 pt-1 text-nowrap align-self-center">
        <b><%= form.label :init, "Middle Inital" %></b>
      </div>
      <div class="col col-md-9">
        <%= form.text_field :init, class:"form-control form-control-sm border-primary fs-4" %>
      </div>
    </div>

    <div class="row mt-3">
      <div class="col col-md-3 pt-1 text-nowrap align-self-center">
        <b><%= form.label :gender, "Gender" %></b>
      </div>
      <div class="col col-md-9">
        <%= form.select :gender, Regi::GENDER_OPTIONS, 
        { }, 
        { class:"form-select form-select-sm border-primary fs-5" } %>
      </div>
    </div>
  
    <div class="row mt-3">
      <div class="col col-md-3 pt-1 text-nowrap align-self-center">
      <b><%= form.label :dob, "Date of Birth" %></b>
      </div>
      <div class="col col-md-9">
        <%= form.date_field :dob, class:"form-control form-control-sm border-primary fs-4" %>
      </div>
    </div>
  
    <div class="mt-3 p-2 border-top text-center">
    <%# Show the login if names are present, even for new records %>
    <% if @regi.first_name.present? || @regi.last_name.present? %>
      <p class="mb-0 small text-muted">
        <strong>Patient Portal Access</strong> Login: 
        <span class="text-dark fw-bold">
          <%= "#{@regi.last_name}#{@regi.first_name}#{@regi.dob&.strftime('%m')}".downcase.gsub(/\s+/, "") %>
        </span>
      </p>
      
      <%# Add a small hint about the actual status %>
      <% unless @regi.onboarding_status == "Issued" || @regi.onboarding_status == "DigiSigned" %>
        <p class="mb-0 x-small text-danger italic">(Not yet activated)</p>
      <% end %>
      
    <% else %>
      <p class="mb-0 small text-muted italic text-secondary">Enter patient details to preview portal access.</p>
    <% end %>
  </div>

    <%# --- 2. THE BUTTONS --- %>
    <div class="d-flex justify-content-left gap-2 mt-4">
      <%= form.submit "Save Registration", class: "btn btn-dark border border-lg border-dark rounded-3 px-2 m-1 fw-bold" %>
    
      <% if @regi.persisted? %>
        <%= link_to "Delete", regi_path(@regi), 
                    class: "btn btn-outline-danger rounded-3 px-2 m-1 fw-bold", 
                    data: { turbo_method: :delete, turbo_confirm: "Permanently delete this registration?" } %>
      <% end %>
    
      <%= link_to "Cancel", regis_path, class: "btn btn-outline-primary rounded-3 px-2 m-1 fw-bold" %>
    </div>

  <% end %> <%# --- THIS IS THE MISSING END FOR THE MAIN FORM (Line 5) --- %>

</div> <%# Closes the 35rem card (Line 3) %>
  
<%# --- 4. THE HIDDEN ENGINES --- %>
<% if @regi.persisted? %>
  <%= form_with url: signup_patient_regi_path(@regi), method: :patch, id: "issue-form", class: "d-none" do %><% end %>
  <%= form_with url: destroy_patient_user_regi_path(@regi), method: :delete, id: "unissue-form", class: "d-none" do %><% end %>
<% end %>