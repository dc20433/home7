<div class="card-header">
  <h2 class="card-title text-center">Filing</h2>
  <h3><%= render 'layouts/identifier' %></h3>
</div>

<div class="card mt-3 mx-auto border-primary" style="width: 33rem;">
  <div class="card shadow border-dark">

    <div class="card-body">
      <%= form_with(model: [@regi, @filing]) do |f| %>
        <% if @show_overwrite_warning %>
          <div class="alert alert-danger p-4 mb-4 border-start border-5 border-danger shadow-sm">
            <h5 class="fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> Confirm Overwrite</h5>
            <p class="mb-3">
              A filing record with this date (<strong><%= @filing.f_date %></strong>) is already existing. 
              Do you want to <strong>Continue to Overwrite</strong> (i.e., proceed to save), or <strong>Cancel</strong>?
            </p>
            
            <div class="d-flex gap-2">
              <%= hidden_field_tag :overwrite, "true" %>
              <%= f.submit "Continue to Overwrite", class: "btn btn-danger px-4 fw-bold" %>
              <%= link_to "Cancel", edit_regi_filing_path(@regi, @filing), class: "btn btn-outline-secondary px-4" %>
            </div>
          </div>
        <% end %>
        
        <% if @filing.errors.any? %>
          <div id="error_explanation">
            <h2><%= pluralize(@filing.errors.count, "error") %> prohibited this filing from being saved:</h2>
            <ul>
            <% @filing.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
            </ul>
          </div>
        <% end %>

        <div class="field mb-3">
          <%# Replace the hardcoded text with a real label and date field %>
          <%= f.label :f_date, "Filed on", class: "form-label fw-bold" %>
          <%= f.date_field :f_date, class: "form-control" %>
        </div>

        <div class="field"><br>
          <%= f.file_field :image,  class:'form-control border-primary' %>
        </div><br>
        
        <div class="field fs-6">
          <b><%= f.label :describe, "File Description" %></b><br>
          <%= f.text_area :describe,  class:'form-control border-primary fs-4' %>
        </div>

        <div class="btn-group m-2 pt-2" role="group"> 
          <%= f.submit "Save", class: "btn btn-sm btn-outline-dark outline-double rounded-pill px-3 m-2 fw-bold" %>
          <%= link_to "Back to Files", regi_filings_path, class: "btn btn-sm btn-outline-success outline-double rounded-pill px-2 m-2 fw-bold" %>   
          <%= link_to 'Go Back', :back, class: "btn btn-sm btn-outline-info outline-double rounded-pill px-2 m-2 fw-bold" %>
          </div>
      <% end %>
    </div>
  </div>
</div>