<h2 class="text-center py-2">All Patient Charts by Date as of <%= Time.now.strftime("%Y-%m-%d %I:%M %p") %></h2>

<%# --- SAFETY SYSTEM: Warn the manager if trying to print too many records --- %>
<% if params[:print] == "true" && @charts.to_a.size > 1500 %>
  <div class="alert alert-danger shadow-sm mx-4 my-2 border-start border-4 border-danger d-print-none">
    <div class="d-flex align-items-center mb-1">
      <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>
      <h6 class="mb-0 fw-bold">Dataset Too Large for Browser Printing</h6>
    </div>
    <p class="mb-0 small text-dark">
      You are attempting to print <b><%= @charts.to_a.size %></b> charts simultaneously. Web browsers run out of memory calculating print layouts of this size, which causes the preview to print blank pages.
    </p>
    <div class="mt-2">
      <button onclick="window.print();" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold me-1">Force Print Anyway</button>
      <%= link_to 'Cancel & Filter', overviews_chart_date_path, class: "btn btn-sm btn-outline-secondary rounded-pill px-3 fw-bold" %>
    </div>
  </div>
<% end %>

<div class="d-flex align-items-center justify-content-center mx-2 gap-1 d-print-none">
  <%= link_to 'All Charts by Name', overviews_chart_name_path, class:"btn btn-success border border-light border-3 rounded-pill px-2 py-0 m-1 fw-bold" %>
  <%= link_to 'All Patient Info', overviews_patient_info_path, class:"btn btn-info border border-light border-3 rounded-pill px-2 py-0 m-1 fw-bold" %>
  <%= link_to 'Patient Registration', regis_path, class:"btn btn-warning border border-light border-3 rounded-pill px-2 py-0 m-1 fw-bold" %>
  
  <%# Server-Side Landscape PDF Link (Forwarding safe hash params) %>
  <%= link_to overviews_chart_date_path(q: params[:q]&.to_unsafe_h, format: :pdf), class: "btn btn-danger border border-light border-3 rounded-pill px-3 py-0 fw-bold me-1" do %>
    <i class="bi bi-file-pdf"></i> Export PDF
  <% end %>

  <%= link_to 'Print Selected', 
              url_for(params.to_unsafe_h.merge(print: true)), 
              class: "btn btn-secondary border border-light border-3 rounded-pill px-3 py-0 fw-bold d-print-none" %>
</div>

<div class="row justify-content-center my-3 d-print-none">
  <%# --- ORIGINAL DESIGN RESTORED: Form targets ONLY From/To date fields --- %>
  <div class="col-6 border border-primary rounded-pill py-1 bg-warning shadow-sm">
    <%= search_form_for @q, url: overviews_chart_date_path, method: :get, class: "d-flex gap-3 align-items-center px-4 justify-content-center" do |f| %>
      
      <div class="d-flex align-items-center gap-2">
        <%= f.label :t_date_gteq, "From:", class: "fw-bold mb-0 text-nowrap" %>
        <%= f.date_field :t_date_gteq, class: "form-control form-control-sm border-primary rounded-pill" %>
      </div>

      <div class="d-flex align-items-center gap-2">
        <%= f.label :t_date_lteq, "To:", class: "fw-bold mb-0 text-nowrap" %>
        <%= f.date_field :t_date_lteq, class: "form-control form-control-sm border-primary rounded-pill" %>
      </div>

      <div class="d-flex gap-3 ms-2">
        <%= f.submit "Search", class: "btn btn-sm btn-dark rounded-pill px-3 fw-bold" %>
        <%= link_to "Clear", overviews_chart_date_path, class: "btn btn-sm btn-light border border-secondary rounded-pill px-3 fw-bold" %>
      </div>

    <% end %>
  </div>
</div>

<table class="table table-bordered align-middle bg-white shadow-sm" style="table-layout: fixed; width: 100%;">
  <thead class="table-light">
    <tr>
      <th class="ps-3" style="width: 110px;">Date</th>
      <th style="width: 160px;">Name</th>
      <th style="width: 20%;">Subjective</th>
      <th style="width: 15%;">Objective</th>
      <th style="width: 20%;">Assessment</th>
      <th class="pe-3" style="width: 35%;">Plan</th>
    </tr>
  </thead>
  <tbody class="fs-4">
    <% last_date = nil %>
    <% @charts.each do |chart| %>
      <tr>
        <td class="ps-3 fw-bold text-primary">
          <% if chart.t_date == last_date %>
            <span class="text-muted" style="font-weight: normal; font-size: 0.85em;"><%= chart.t_date %></span>
          <% else %>
            <%= chart.t_date %>
          <% end %>
          <% last_date = chart.t_date %>
        </td>
        <td> 
          <%= link_to chart.regi.p_name, regi_charts_path(chart.regi_id) %>
          (<%= chart.regi.p_age %>)
        </td>
        <td><%= chart.subj %></td>
        <td><%= chart.obj %></td>
        <td><%= chart.assess %></td>
        <td class="pe-3"><%= chart.plan %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="d-flex justify-content-center my-4 d-print-none">
  <%== pagy_bootstrap_nav(@pagy) if @pagy&.pages.to_i > 1 %>
</div>

<%# --- CONSOLIDATED & PRINT-SAFE TRIGGER BLOCK --- %>
<% if params[:print] == "true" %>
  <script>
    (function() {
      const recordCount = <%= @charts.to_a.size %>;
      
      // Stop print process if records exceed 1,500 (prevents browser engine freeze)
      if (recordCount > 1500) {
        console.warn("Print trigger skipped: Dataset too large for browser standard printing.");
        return;
      }

      function triggerPrint() {
        setTimeout(() => {
          window.print();
        }, 1200); 
      }

      if (document.readyState === 'complete') {
        triggerPrint();
      } else {
        window.addEventListener('load', triggerPrint);
      }

      window.onafterprint = function() {
        window.location.href = window.location.href.replace(/[&?]print=true/, '');
      };
    })();
  </script>

  <style>
    @media print {
      /* Hide navigation headers, search forms, and navigation buttons without breaking outer layout wrappers */
      .btn, 
      .nav, 
      .navbar,
      .sidebar,
      .search-bar, 
      footer, 
      header,
      .card-header, 
      .d-print-none,
      form { 
        display: none !important; 
      }
      
      body { 
        background-color: white !important; 
        font-size: 9pt !important; 
        margin: 0.5cm !important;
      }
      
      .table { 
        border-collapse: collapse !important;
        border: 1px solid #000000 !important; 
        width: 100% !important; 
        table-layout: fixed !important;
      }

      .table th, .table td {
        border: 1px solid #dee2e6 !important;
        padding: 6px !important;
        word-wrap: break-word !important;
        overflow-wrap: break-word !important;
        white-space: normal !important;
      }

      /* Avoid breaking rows awkwardly mid-text across page borders */
      tr {
        page-break-inside: avoid !important;
        break-inside: avoid !important;
      }
    }
  </style>
<% end %>