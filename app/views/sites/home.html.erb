<div class="d-flex flex-column justify-content-center align-items-center h-100 text-center" style="min-height: calc(100vh - 100px);">
  <div class="bg-white bg-opacity-25 rounded-3 shadow-lg px-3 py-5 mb-5 bg-body">
    <h1 class="display-4 fw-bolder text-danger text-shadow-custom" style="color: #2c3e50;">Welcome to Zhang's Acupuncture</h1>
    <h2 class="display-6 text-danger text-shadow-custom">Traditional Chinese Medical Treatment and Medicine</h2>
    
    <%# app/views/sites/home.html.erb %>

<div class="mt-4 d-grid gap-3 d-sm-flex justify-content-sm-center">
  <% if authenticated? %>
    <% if Current.user.admin? || Current.user.manager? %>
      <%= link_to "Go to Patient List", regis_path, class: "btn btn-lg btn-info rounded-pill border border-dark border-3 fw-bold px-5 shadow" %>
    <% elsif Current.user.regi.present? %>
      <% if Current.user.regi.patients.any? %>
        <%# Returning Patient: Edit their most recent record %>
        <%= link_to "Update My Info", edit_regi_patient_path(Current.user.regi, Current.user.regi.patients.last), 
            class: "btn btn-lg btn-success rounded-pill border border-dark border-3 fw-bold px-5 shadow" %>
      <% else %>
        <%# New Patient: Start a fresh intake form %>
        <%= link_to "Fill Out My Info", new_regi_patient_path(Current.user.regi), 
            class: "btn btn-lg btn-success rounded-pill border border-dark border-3 fw-bold px-5 shadow" %>
      <% end %>
    <% else %>
      <div class="alert alert-warning rounded-pill px-4">Account active. No patient record linked.</div>
    <% end %>
  <% end %>
</div>
  </div>
</div>