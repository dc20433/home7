<div class="container text-center mt-5">
  <div class="card shadow p-5 border-success">
    <h1 class="text-success mb-4">Submission Received</h1>
    <p class="lead">Thank you for submitting your information and signing the consent form.</p>
    <hr class="my-4">
    
    <%# Display the timestamp if it was saved %>
    <% if @patient&.signed_at.present? %>
       <p class="text-muted italic">Signed on: <%= @patient.signed_at.strftime("%B %d, %Y at %I:%M %p") %></p>
    <% end %>

    <div class="alert alert-warning mb-5">
      Please <strong>hand this device back to a staff member</strong>.
    </div>
    
    <%= button_to "Sign Out Safely", session_path, method: :delete, data: { turbo: false }, 
    class: "btn btn-dark btn-lg shadow" %>
  </div>
</div>