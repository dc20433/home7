<div class="container mt-5">
  <div class="card mx-auto shadow" style="max-width: 400px; border-radius: 15px;">
    <div class="card-body p-4">
      <h4 class="text-center mb-4">Secure Your Account</h4>
      
      <%= form_with(model: Current.user, url: authenticated_password_path, method: :patch) do |f| %>
        <div class="mb-3">
          <%= f.label :password, "New Password", class: "form-label fw-bold" %>
          <%= f.password_field :password, class: "form-control border-primary", autofocus: true %>
        </div>
        
        <div class="mb-4">
          <%= f.label :password_confirmation, "Confirm New Password", class: "form-label fw-bold" %>
          <%= f.password_field :password_confirmation, class: "form-control border-primary" %>
        </div>

        <%= f.submit "Activate Account", class: "btn btn-primary w-100 rounded-pill fw-bold" %>
      <% end %>
    </div>
  </div>
</div>